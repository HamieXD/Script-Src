--// ===== Logic: ซื้อ, ทำอาหาร & วางของ (Thread 1) =====
toggleFarmBtn.MouseButton1Click:Connect(function()
    autoFarm = not autoFarm
    if autoFarm then
        toggleFarmBtn.Text = "STOP AUTO BUY/COOK/PLACE"
        toggleFarmBtn.BackgroundColor3 = Color3.fromRGB(200, 100, 50)
        
        task.spawn(function()
            math.randomseed(tick()) 
            
            while autoFarm and scriptRunning do
                pcall(function()
                    local buyItem = ReplicatedStorage:FindFirstChild("BuyRecipeItem", true) or ReplicatedStorage.Riese.Remotes.BuyRecipeItem
                    local startCooking = ReplicatedStorage:FindFirstChild("StartCooking", true) or ReplicatedStorage.Riese.Remotes.StartCooking
                    local placeItem = ReplicatedStorage:FindFirstChild("PlaceDownItem", true) or ReplicatedStorage.Riese.Remotes.PlaceDownItem
                    
                    local plotStr = tostring(currentPlot)
                    local plotFolder = workspace:FindFirstChild("Plots") and workspace.Plots:FindFirstChild(plotStr)
                    local potRemote = plotFolder and plotFolder:FindFirstChild("CookingPotServerModel") and plotFolder.CookingPotServerModel:FindFirstChild("Remote")
                    
                    if buyItem and startCooking and potRemote and placeItem then
                        
                        -- 🛑 1. เช็คว่าร้านเต็มมั้ย
                        while getCookedTool() ~= nil and (autoFarm and scriptRunning) do
                            currentCookStatus = "Shop FULL! Waiting for sales..."
                            updateStatus(currentCookStatus, currentCheckoutStatus)
                            
                            local isPlaced = false
                            local counterLetters = {"A", "B", "C", "D", "E"}
                            for _, letter in ipairs(counterLetters) do
                                if isPlaced or not (autoFarm and scriptRunning) then break end
                                local targetCounter = plotFolder:FindFirstChild("Counters") and plotFolder.Counters:FindFirstChild(letter)
                                if targetCounter then
                                    for slot = 1, 6 do
                                        if getCookedTool() == nil then
                                            isPlaced = true
                                            break
                                        end
                                        pcall(function() placeItem:FireServer(getCookedTool(), targetCounter, slot) end)
                                        safeWait(0.1) 
                                    end
                                end
                            end
                            if getCookedTool() ~= nil then safeWait(2) end
                        end
                        
                        if not (autoFarm and scriptRunning) then return end
                        
                        -- 💰 2. SMART BUDGET CHECK (เช็คเงินขั้นต่ำ)
                        local targetReserve = tonumber(reserveInput.Text) or 0
                        local myMoney = getCurrentMoney()
                        
                        if myMoney < targetReserve then
                            currentCookStatus = "Saving Cash! ($" .. myMoney .. " / $" .. targetReserve .. ")"
                            updateStatus(currentCookStatus, currentCheckoutStatus)
                            safeWait(3) -- ยืนรอ 3 วิ ให้ลูกค้าซื้อของเอาเงินมาให้
                            return -- ข้ามลูปการทำอาหารรอบนี้ไปก่อน
                        end
                        
                        -- 🎯 3. เลือกว่าจะทำหมวดไหน และสุ่มอาหาร
                        local targetCategory = categoryOrder[currentCategoryIdx]
                        local menusInCategory = allMenusByCategory[targetCategory]
                        local foodToCook = menusInCategory[math.random(1, #menusInCategory)]
                        
                        -- ขยับคิวไปหมวดถัดไป
                        currentCategoryIdx = currentCategoryIdx + 1
                        if currentCategoryIdx > #categoryOrder then currentCategoryIdx = 1 end
                        
                        currentMenuLabel.Text = "🎲 ["..targetCategory.."] "..foodToCook
                        
                        -- 💸 4. ลงมือซื้อวัตถุดิบ
                        currentCookStatus = "Buying " .. foodToCook .. "..."
                        updateStatus(currentCookStatus, currentCheckoutStatus)
                        task.spawn(function() pcall(function() buyItem:FireServer(foodToCook, 1) end) end)
                        safeWait(0.5) 
                        
                        -- 🍳 5. เริ่มทำอาหาร
                        currentCookStatus = "Ordering..."
                        updateStatus(currentCookStatus, currentCheckoutStatus)
                        task.spawn(function() pcall(function() startCooking:InvokeServer(foodToCook) end) end)
                        
                        local spawnedFolder = plotFolder:FindFirstChild("SpawnedIngredients")
                        local waitLimit = 0
                        while spawnedFolder and #spawnedFolder:GetChildren() == 0 and waitLimit < 2 do
                            if not safeWait(0.1) then break end
                            waitLimit = waitLimit + 0.1
                        end
                        
                        if spawnedFolder and #spawnedFolder:GetChildren() > 0 then
                            for _, ing in ipairs(spawnedFolder:GetChildren()) do
                                if not (autoFarm and scriptRunning) then break end
                                pcall(function() potRemote:FireServer("AddIngredient", ing.Name) end)
                                task.wait(0.05) 
                            end
                        else
                            local allIngredients = ReplicatedStorage:FindFirstChild("Ingredients")
                            if allIngredients then
                                for _, ing in ipairs(allIngredients:GetChildren()) do
                                    if not (autoFarm and scriptRunning) then break end
                                    pcall(function() potRemote:FireServer("AddIngredient", ing.Name) end)
                                    task.wait(0.01) 
                                end
                            end
                        end
                        
                        currentCookStatus = "Watching Pot..."
                        updateStatus(currentCookStatus, currentCheckoutStatus)
                        
                        local toolToPlace = nil
                        local waitTime = 0
                        while not toolToPlace and waitTime < 120 do
                            if not (autoFarm and scriptRunning) then break end
                            pcall(function() potRemote:FireServer("ClaimDessert") end)
                            toolToPlace = getCookedTool()
                            if not toolToPlace then
                                safeWait(1)
                                waitTime = waitTime + 1
                            end
                        end
                        
                        if toolToPlace then
                            currentCookStatus = "Fast Scanning Slots..."
                            updateStatus(currentCookStatus, currentCheckoutStatus)
                            
                            local isPlaced = false
                            local counterLetters = {"A", "B", "C", "D", "E"}
                            
                            for _, letter in ipairs(counterLetters) do
                                if isPlaced or not (autoFarm and scriptRunning) then break end
                                local targetCounter = plotFolder:FindFirstChild("Counters") and plotFolder.Counters:FindFirstChild(letter)
                                if targetCounter then
                                    for slot = 1, 6 do
                                        if getCookedTool() == nil then
                                            isPlaced = true
                                            break
                                        end
                                        currentCookStatus = "Trying " .. letter .. "-" .. slot
                                        updateStatus(currentCookStatus, currentCheckoutStatus)
                                        pcall(function() placeItem:FireServer(getCookedTool(), targetCounter, slot) end)
                                        safeWait(0.1) 
                                    end
                                end
                            end
                        end
                    end
                end)
                task.wait(0.2)
            end
            
            if scriptRunning then
                toggleFarmBtn.Text = "START AUTO BUY/COOK/PLACE"
                toggleFarmBtn.BackgroundColor3 = Color3.fromRGB(50, 150, 50)
                currentMenuLabel.Text = "🎲 Menu: None"
                currentCookStatus = "Idle"
                updateStatus(currentCookStatus, currentCheckoutStatus)
            end
        end)
    else
        toggleFarmBtn.Text = "START AUTO BUY/COOK/PLACE"
        toggleFarmBtn.BackgroundColor3 = Color3.fromRGB(50, 150, 50)
        currentCookStatus = "Stopping..."
        updateStatus(currentCookStatus, currentCheckoutStatus)
    end
end)

--// ===== Logic: คิดเงินลูกค้า (Thread 2) =====
toggleCheckoutBtn.MouseButton1Click:Connect(function()
    autoCheckout = not autoCheckout
    if autoCheckout then
        toggleCheckoutBtn.Text = "STOP AUTO CHECKOUT"
        toggleCheckoutBtn.BackgroundColor3 = Color3.fromRGB(200, 100, 50)
        
        task.spawn(function()
            while autoCheckout and scriptRunning do
                pcall(function()
                    currentCheckoutStatus = "Waiting for customer..."
                    updateStatus(currentCookStatus, currentCheckoutStatus)
                    
                    local checkoutReady = ReplicatedStorage:FindFirstChild("CheckoutReady", true) or ReplicatedStorage.Riese.Remotes.CheckoutReady
                    if checkoutReady then checkoutReady:FireServer() end
                    
                    local plotStr = tostring(currentPlot)
                    local plotFolder = workspace:FindFirstChild("Plots") and workspace.Plots:FindFirstChild(plotStr)
                    
                    if plotFolder then
                        for _, prompt in ipairs(plotFolder:GetDescendants()) do
                            if prompt:IsA("ProximityPrompt") then
                                if prompt.ActionText:lower():match("checkout") or prompt.Name:lower():match("checkout") then
                                    if fireproximityprompt then
                                        currentCheckoutStatus = "Checking out!"
                                        updateStatus(currentCookStatus, currentCheckoutStatus)
                                        fireproximityprompt(prompt)
                                    end
                                end
                            end
                        end
                    end
                end)
                task.wait(0.5) 
            end
            
            if scriptRunning then
                toggleCheckoutBtn.Text = "START AUTO CHECKOUT"
                toggleCheckoutBtn.BackgroundColor3 = Color3.fromRGB(50, 100, 200)
                currentCheckoutStatus = "Idle"
                updateStatus(currentCookStatus, currentCheckoutStatus)
            end
        end)
    else
        toggleCheckoutBtn.Text = "START AUTO CHECKOUT"
        toggleCheckoutBtn.BackgroundColor3 = Color3.fromRGB(50, 100, 200)
        currentCheckoutStatus = "Stopping..."
        updateStatus(currentCookStatus, currentCheckoutStatus)
    end
end)
