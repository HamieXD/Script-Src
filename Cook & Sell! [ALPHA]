local function safeWait(duration)
    local elapsed = 0
    while elapsed < duration do
        if not (autoFarm and scriptRunning) then return false end
        task.wait(0.1)
        elapsed = elapsed + 0.1
    end
    return true
end

local function getCookedTool()
    local char = player.Character
    if char then
        for _, v in ipairs(char:GetChildren()) do
            if v:IsA("Tool") then return v end
        end
    end
    for _, v in ipairs(player.Backpack:GetChildren()) do
        if v:IsA("Tool") then return v end
    end
    return nil
end

-- 💰 ฟังก์ชันดึงจำนวนเงินปัจจุบันของเชฟ (อ่านจาก UI และตัด $ กับ , ออกให้เหลือแต่ตัวเลข)
local function getCurrentMoney()
    local amountLabel = player:FindFirstChild("PlayerGui")
        and player.PlayerGui:FindFirstChild("Balance")
        and player.PlayerGui.Balance:FindFirstChild("Frame")
        and player.PlayerGui.Balance.Frame:FindFirstChild("Amount")

    if amountLabel and amountLabel:IsA("TextLabel") then
        local rawText = amountLabel.Text
        local cleanNum = rawText:gsub("[%D]", "") -- ลบตัวอักษรทุกอย่างที่ไม่ใช่ตัวเลข
        return tonumber(cleanNum) or 0
    end
    return 0
end

